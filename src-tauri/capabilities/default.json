{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "fs:default",
    "fs:allow-write-file",
    "fs:allow-read-file",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:write-all",
    "fs:read-all",
    "sql:default",
    "sql:allow-execute",
    {
      "identifier": "fs:allow-write-file",
      "preference": {},
      "requirement": { "identifier": "any" }
    }
  ]
}